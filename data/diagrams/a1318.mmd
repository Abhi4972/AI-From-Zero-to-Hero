flowchart TD
  AS["/.well-known/oauth-authorization-server<br/>(RFC 8414)"] --> I{{"Issuer matches<br/>the expected one?"}}
  I -->|"no"| X["Stop"]
  I -->|"yes"| EN{{"Enrollment"}}
  EN -->|"default"| CIMD["CIMD: server pulls the client's<br/>metadata document"]
  EN -->|"deprecated"| DCR["DCR (RFC 7591)"]
  CIMD --> CODE["Code flow + PKCE (RFC 7636)"]
  DCR --> CODE
  CODE --> TOK["Token with a resource indicator<br/>(RFC 8707): audience-bound"]
  TOK --> RS["Resource server checks<br/>issuer, audience, expiry, scope"]
