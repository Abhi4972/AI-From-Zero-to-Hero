flowchart TD
  AIR["Sound pressure"] --> MIC["Microphone"]
  MIC --> SAMP["Sample: sr times per second<br/>(16 kHz → max 8 kHz, Nyquist)"]
  SAMP --> Q["Quantize: 16-bit integers"]
  Q --> WAV["Waveform: floats in [−1, 1]"]
  WAV --> FFT["Fourier transform"]
  FFT --> SPEC["Frequencies and their strengths"]
