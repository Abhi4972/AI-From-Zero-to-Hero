flowchart TD
  S(["START"]) --> N1["Node: plan<br/>(state) → update"]
  N1 --> N2["Node: call tool"]
  N2 --> C{{"Conditional edge"}}
  C -->|"more work"| N1
  C -->|"needs review"| H["Interrupt: a human<br/>inspects or edits the state"]
  H --> N2
  C -->|"done"| E(["END"])
  N2 -.->|"after every node"| CK[("Checkpointer")]
  CK -.->|"after a crash: resume here"| N2
