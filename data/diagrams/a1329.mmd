flowchart TD
  REQ["Request in flight"] --> T{{"Idle timeout or<br/>total deadline hit,<br/>or the user gives up"}}
  T --> CAN["Cancel the request"]
  CAN --> RACE{{"Response already sent?"}}
  RACE -->|"yes"| IGN["Ignore the late response"]
  RACE -->|"no"| STOP["Server stops the work"]
  REQ -.->|"connection drops"| RF["Reconnect means refetch;<br/>retries need an idempotency key"]
