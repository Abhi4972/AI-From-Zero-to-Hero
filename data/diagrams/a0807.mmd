flowchart TD
  IMG["Image 512×512×3"] --> VE["VAE encoder"]
  VE --> LAT["Latent 64×64×4<br/>48× fewer numbers"]
  LAT --> DIF["Diffusion in latent space<br/>U-Net or DiT"]
  TXT["Prompt"] --> TE["Text encoder (CLIP / T5)"]
  TE -->|"cross-attention"| DIF
  DIF --> LAT2["Denoised latent"]
  LAT2 --> VD["VAE decoder"]
  VD --> OUT["Image"]
