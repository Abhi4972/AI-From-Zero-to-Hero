flowchart TD
  REF["5-second reference clip"] --> SPK["Speaker identity<br/>(who)"]
  SRC["Text, or source speech"] --> CON["Content<br/>(what)"]
  SPK --> GEN["Generator"]
  CON --> GEN
  GEN --> OUT["Content in the target voice"]
  OUT --> WM["Watermark it<br/>(AudioSeal)"]
  OUT --> EV["Check: speaker similarity,<br/>WER of the round trip"]
  CONS["Consent from the voice owner"] -.-> REF
