flowchart TD
  CTX["Context"] --> DR["Draft model Mq<br/>guesses k tokens"]
  DR --> VF["Target model Mp<br/>checks all k in one pass"]
  VF --> RULE{{"Accept token with<br/>min(1, p/q)"}}
  RULE -->|"accepted"| KEEP["Keep it, check the next"]
  RULE -->|"rejected"| FIX["Sample from norm(max(0, p − q)),<br/>stop this round"]
  KEEP --> CTX
  FIX --> CTX
  SP["Speedup grows with the<br/>acceptance rate α"] -.-> RULE
