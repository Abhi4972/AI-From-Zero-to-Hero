flowchart TD
  SEQ["Sequence: text tokens +<br/>continuous image latent patches"] --> T["One transformer"]
  T --> TL["Text positions<br/>causal attention<br/>next-token loss"]
  T --> IL["Image positions<br/>bidirectional within the image<br/>diffusion (noise-prediction) loss"]
  TL --> L["Total loss = LM loss + λ · diffusion loss"]
  IL --> L
  IL --> D["At inference: denoise latents,<br/>decode with the VAE"]
