flowchart TD
  IMG["Images or video frames"] --> V["Frozen vision encoder"]
  V --> PR["Perceiver resampler<br/>fixed number of visual tokens"]
  TXT["Interleaved text"] --> L1["Frozen LM layers"]
  PR --> X["Gated cross-attention<br/>tanh gate starts at 0"]
  L1 --> X
  X --> L2["Next frozen LM layers"]
  L2 --> OUT["Next-token prediction<br/>few-shot in context"]
  M["Mask: each text token sees<br/>only the image just before it"] -.-> X
