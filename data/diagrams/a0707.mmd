flowchart TD
  T["Tokens t1 t2 t3 t4"] --> M["Causal mask<br/>position i sees only ≤ i"]
  M --> DEC["Decoder stack"]
  DEC --> L["Shift by one: predict t2 from t1,<br/>t3 from t1..t2, …<br/>all positions in one pass"]
  L --> TR["Training: parallel"]
  DEC --> INF["Inference: one token at a time,<br/>append, repeat"]
  INF --> SAMP["Decoding: greedy, temperature,<br/>top-k, top-p"]
