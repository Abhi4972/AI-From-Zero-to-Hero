flowchart TD
  W["Waiting queue"] --> AD{{"Free KV blocks<br/>for the next request?"}}
  AD -->|"yes"| RUN["Add to RUNNING<br/>(blocks of 16 tokens)"]
  AD -->|"no"| W
  RUN --> CH["Long prompt? prefill<br/>in 512-token chunks"]
  CH --> STEP["One forward step:<br/>one token per sequence"]
  STEP --> DONE{{"Sequence finished?"}}
  DONE -->|"yes"| REL["Release its blocks"]
  DONE -->|"no"| STEP
  REL --> AD
