flowchart TD
  R["New request"] --> W["Walk the radix tree<br/>along its tokens"]
  W --> M["Longest matching prefix<br/>e.g. system + document"]
  M --> RE["Reuse those KV blocks"]
  M --> NEW["Prefill only the new suffix"]
  RE --> S["Scheduler serves requests<br/>from the same branch together"]
  NEW --> S
  S --> E["Evict cold branches,<br/>whole branch at a time"]
