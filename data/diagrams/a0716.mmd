flowchart TD
  CTX["Context"] --> DR["Draft model proposes<br/>N tokens (cheap)"]
  DR --> VF["Target model scores all N<br/>in one forward pass"]
  VF --> AC{{"Accept each token with<br/>prob min(1, q/p)"}}
  AC -->|"all accepted"| BONUS["Keep them + one bonus token"]
  AC -->|"first rejection"| RS["Resample that token from<br/>the residual distribution;<br/>drop the rest"]
  BONUS --> CTX
  RS --> CTX
  SAME["Output distribution identical<br/>to the target model alone"] -.-> AC
