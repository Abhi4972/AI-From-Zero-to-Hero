flowchart TD
  S["Decoder state s(t−1)<br/>the query"] --> SC["Score against every<br/>encoder state h(i)"]
  H["Encoder states h(1) … h(n)<br/>the keys and values"] --> SC
  SC --> SM["Softmax → weights α(t,i)<br/>sum to 1"]
  SM --> CTX["Context = Σ α(t,i) · h(i)"]
  H --> CTX
  CTX --> D["Decoder predicts the next word<br/>looking at the whole source"]
