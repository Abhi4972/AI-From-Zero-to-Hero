flowchart TD
  IN["Learner answer<br/>(text, voice, photo)"] --> SIG["Correct, partial or stuck?"]
  SIG --> BKT["Update mastery<br/>(knowledge tracing)"]
  BKT --> SEL["Pick next concept<br/>from the graph"]
  SEL --> SOC["Socratic prompt or hint"]
  SOC --> SAFE["Age-appropriate filter"]
  SAFE --> OUT["Tutor reply"]
  BKT --> MEM["Minimal memory,<br/>parent access"]
