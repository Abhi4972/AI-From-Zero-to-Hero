flowchart TD
  V["Video clip"] --> SAMP["Sample frames<br/>uniform, keyframes or dynamic FPS"]
  SAMP --> ENC["Image encoder per frame"]
  ENC --> POOL["Pool tokens per frame<br/>to fit the budget"]
  POOL --> TIME["Add time: frame order or<br/>time-aligned positions"]
  AU["Audio branch (optional)"] --> LLM
  TIME --> LLM["LLM"]
  LLM --> OUT["Answer with timestamps<br/>'the cat jumps at 00:12–00:14'"]
