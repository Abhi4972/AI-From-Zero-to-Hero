flowchart TD
  S["the quick brown fox jumps"] --> SEL["Select 15% of tokens"]
  SEL --> M80["80% → [MASK]"]
  SEL --> M10["10% → random token"]
  SEL --> M10b["10% → unchanged"]
  M80 --> ENC["Bidirectional encoder<br/>sees both sides"]
  M10 --> ENC
  M10b --> ENC
  ENC --> PRED["Predict the original token<br/>at selected positions only"]
  PRED --> USE["Then: embeddings, classifiers,<br/>retrieval, NER"]
