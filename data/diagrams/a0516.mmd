flowchart TD
  C["Training text"] --> CNT["Count n-grams<br/>e.g. (w1, w2) → w3"]
  CNT --> P["P(w3 | w1, w2) = count ratio"]
  P --> SM["Smoothing<br/>unseen n-grams get some mass"]
  SM --> LM["Language model"]
  LM --> GEN["Generate: sample the next word"]
  LM --> PPL["Perplexity on held-out text<br/>lower = less surprised"]
