flowchart TD
  SRC["Source tokens + positions"] --> ENC["Encoder block × N<br/>self-attention (no mask) → FFN<br/>residual + norm around each"]
  TGT["Target tokens so far + positions"] --> D1["Decoder: masked self-attention"]
  D1 --> D2["Cross-attention<br/>queries from the decoder,<br/>keys and values from the encoder"]
  ENC --> D2
  D2 --> D3["Feed-forward"]
  D3 --> OUT["Linear + softmax<br/>next-token probabilities"]
