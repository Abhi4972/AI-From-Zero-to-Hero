flowchart TD
  IMG["Image H × W × 3"] --> P["Cut into P × P patches<br/>(H/P) × (W/P) of them"]
  P --> F["Flatten each patch<br/>P·P·3 numbers"]
  F --> L["Linear projection<br/>to D dimensions"]
  L --> POS["Add position embeddings<br/>(+ CLS or register tokens)"]
  POS --> T["Transformer encoder"]
  T --> O["Patch tokens out:<br/>pooled for the image vector,<br/>or passed on to an LLM"]
