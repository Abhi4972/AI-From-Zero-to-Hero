flowchart TD
  T["Review text"] --> P["Preprocess: tokenize,<br/>keep negations ('not good')"]
  P --> R{{"Represent"}}
  R --> BOW["TF-IDF with n-grams"]
  R --> EMB["Averaged or contextual embeddings"]
  BOW --> C["Classifier<br/>logistic regression, Naive Bayes"]
  EMB --> C
  C --> O["positive / negative<br/>+ probability"]
  O --> EV["Evaluate per class:<br/>precision, recall, F1"]
