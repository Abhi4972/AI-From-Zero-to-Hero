flowchart TD
  PDF["PDF"] --> PG["Page images<br/>no OCR, no chunking"]
  PG --> ENC["VLM encoder (PaliGemma)<br/>one vector per patch"]
  ENC --> IDX[("Index of patch vectors")]
  Q["Query"] --> QE["One vector per query token"]
  QE --> MS["Late interaction (MaxSim):<br/>each query token takes its best patch,<br/>sum over tokens"]
  IDX --> MS
  MS --> TOP["Top pages"]
  TOP --> GEN["VLM answers from the page images"]
