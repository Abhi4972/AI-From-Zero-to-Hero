flowchart TD
  SYS["System prompt + tools<br/>(stable)"] --> DOCS["Long context, RAG documents<br/>(stable for a while)"]
  DOCS --> BP["Cache breakpoint"]
  BP --> USER["User message<br/>(changes every time)"]
  USER --> REQ["Request"]
  REQ --> HIT{{"Prefix matches a<br/>recent request?"}}
  HIT -->|"yes"| CHEAP["Cached tokens billed at a fraction,<br/>faster first token"]
  HIT -->|"no"| WRITE["Full price + cache write"]
