flowchart LR
  S["Agent step"] --> G{{"Verification gate:<br/>check against<br/>the environment"}}
  G -->|"pass"| N["Next step"]
  G -->|"fail"| F["Name the failure"]
  F --> F1["Hallucinated action<br/>tool or argument<br/>that doesn't exist"]
  F --> F2["Lost context<br/>forgets earlier facts"]
  F --> F3["Loops<br/>the same call again"]
  F --> F4["Wrong termination<br/>stops early or never"]
  F --> F5["Spec drift<br/>ignores the system prompt"]
