flowchart TD
  L["100+ languages of text"] --> SPM["One shared SentencePiece vocabulary"]
  SPM --> PT["Pretrain one model<br/>(mBERT, XLM-R)"]
  PT --> FT["Fine-tune on labels<br/>in one source language"]
  FT --> ZS["Zero-shot on other languages<br/>cross-lingual transfer"]
  ZS --> EV["Evaluate per language,<br/>never only the average"]
