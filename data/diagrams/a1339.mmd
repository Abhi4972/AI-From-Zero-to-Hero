flowchart TD
  SRC["Source construct"] --> OPT["Optimizer"]
  OPT --> I1["x / 7<br/>→ multiply,<br/>then shift"]
  OPT --> I2["switch<br/>→ jump table"]
  OPT --> I3["loop<br/>→ vectorized<br/>or unrolled"]
  OPT --> I4["tail call<br/>→ jmp"]
  OPT --> I5["if/else<br/>→ cmov"]
  I1 --> READ["Read it back: match the shape,<br/>re-derive the source"]
  I2 --> READ
  I3 --> READ
  I4 --> READ
  I5 --> READ
