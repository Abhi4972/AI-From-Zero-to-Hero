flowchart TD
  PL["Plan<br/>find nodes whose inputs changed"] --> RUN["Run<br/>execute them in parallel;<br/>none sees the others' writes"]
  RUN --> UP["Update<br/>sort tasks by task path,<br/>apply all writes through the channels"]
