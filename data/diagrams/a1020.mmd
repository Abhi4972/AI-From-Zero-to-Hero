flowchart TD
  T["Tokens"] --> EMB["Embedding"]
  EMB --> MLA["Multi-head latent attention<br/>K and V compressed into a small latent"]
  MLA --> MOE["DeepSeekMoE<br/>1 shared + 8 of 256 routed experts"]
  MOE --> REP["× 61 layers (first 3 dense)"]
  REP --> HEAD["Output head"]
  REP --> MTP["MTP module<br/>predicts one token further"]
  B["Router bias, not an aux loss,<br/>balances the experts"] -.-> MOE
  DP["Trained with DualPipe, FP8"] -.-> REP
