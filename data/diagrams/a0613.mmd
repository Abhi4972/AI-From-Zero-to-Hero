flowchart TD
  W["Waveform"] --> ENC["Encoder<br/>one vector per frame (e.g. 12.5 Hz)"]
  ENC --> Q1["Codebook 1 quantizes z"]
  Q1 --> R1["Residual = z − code"]
  R1 --> Q2["Codebook 2 quantizes the residual"]
  Q2 --> QN["… codebook N"]
  QN --> TOK["N tokens per frame<br/>codebook 0 = semantic (Mimi)"]
  TOK --> DEC["Decoder → waveform"]
