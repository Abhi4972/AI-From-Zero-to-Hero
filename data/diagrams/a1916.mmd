flowchart TD
  L["Label on an issue"] --> WH["Webhook to dispatcher"]
  WH --> CAP{{"Repo under its<br/>daily cap?"}}
  CAP -->|"no"| DEF["Defer"]
  CAP -->|"yes"| SB["Fresh sandbox:<br/>clone, infer build"]
  SB --> AG["Agent loop with<br/>short-lived token"]
  AG --> CHK{{"Full tests pass,<br/>no workflow edits?"}}
  CHK -->|"no"| STOP["Halt, report"]
  CHK -->|"yes"| PR["Open PR; branch<br/>protection guards main"]
