flowchart TD
  M["Model"] --> S["Sample a rationale<br/>and an answer"]
  S --> J{{"Answer correct?"}}
  J -->|"yes"| K["Keep the rationale"]
  K --> F["Fine-tune on the kept rationales<br/>(STaR)"]
  F -->|"next round"| M
  J -->|"no"| D["STaR drops it<br/>V-STaR keeps it as a negative"]
  D --> V["Verifier trained with DPO<br/>on correct vs incorrect"]
  V --> B["At inference: sample many,<br/>let the verifier pick"]
