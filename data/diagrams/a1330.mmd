%% after: Seven Controls
flowchart TD
  REG["Official MCP Registry<br/>an index of metadata"] --> ADM{{"Admission check"}}
  ADM --> N["Namespace verified"]
  ADM --> PIN["Exact version and digest pinned"]
  ADM --> REV["Reviewed descriptors"]
  N --> OK["Admitted to your allowlist"]
  PIN --> OK
  REV --> OK
  OK --> DR{{"Upstream drifts?<br/>new digest, changed tools"}}
  DR -->|"yes"| HOLD["Hold the update,<br/>keep serving the pinned version"]
  HOLD --> RB["Or roll back"]
