flowchart TD
  V["Video"] --> VAE["3D VAE<br/>compress space and time"]
  VAE --> P["Spacetime patches<br/>one flat sequence"]
  P --> DIT["Diffusion transformer<br/>attends across space and time"]
  TXT["Prompt → large text encoder"] --> DIT
  DIT --> LAT["Denoised latent video"]
  LAT --> DEC["3D VAE decoder"]
  DEC --> OUT["Frames that stay consistent<br/>(no per-frame flicker)"]
