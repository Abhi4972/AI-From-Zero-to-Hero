flowchart TD
  A["Binary A"] --> SIG["Signatures per function:<br/>name, bytes, size, call graph, constants"]
  B["Binary B"] --> SIG
  SIG --> GR["Greedy matcher<br/>strongest signature first"]
  GR --> M["Matched pairs<br/>with a quality score"]
  GR --> U["Unmatched: new or changed"]
  U --> SE["Symbolic execution<br/>solve for an input that reaches it"]
  SE --> IN["Concrete input"]
