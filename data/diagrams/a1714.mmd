flowchart TD
  Q["Question"] --> L1{{"L1 semantic cache:<br/>similar question seen?"}}
  L1 -->|"hit"| A["Cached answer, no call"]
  L1 -->|"miss"| P["Build prompt:<br/>static part first, dynamic last"]
  P --> L2{{"L2 provider cache:<br/>prefix cached?"}}
  L2 -->|"yes"| CR["Prefix billed at ~0.1×"]
  L2 -->|"no"| CW["Write the cache (1.25×)"]
  CR --> M["Model answers"]
  CW --> M
  M --> ST["Store in L1"]
