flowchart TD
  REQ["Incoming request"] --> E["Validate the envelope<br/>evidence, not identity"]
  E --> RT["Validate routing:<br/>headers match the body"]
  RT --> PIN{{"Descriptor matches<br/>the pinned hash?"}}
  PIN -->|"no"| BL["Block: metadata changed"]
  PIN -->|"yes"| SC["Static scan of descriptions<br/>(a tripwire, not proof)"]
  SC --> NS["Namespace tools per server<br/>before merging"]
  NS --> POL["Policy decision"]
  POL --> ST["Carry MRTR state<br/>signed or server-held"]
