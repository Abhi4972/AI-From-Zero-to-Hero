flowchart TD
  GOAL["Task"] --> SS["Screenshot<br/>(+ accessibility tree)"]
  SS --> G["Ground: instruction → element<br/>and its coordinates"]
  G --> ACT["Action from a small schema<br/>click, type, scroll, key, done"]
  ACT --> ENV["Desktop or browser"]
  ENV --> SS
  MEM["Memory: summarize old steps<br/>so screenshots fit in context"] -.-> G
