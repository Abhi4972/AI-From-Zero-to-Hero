flowchart TD
  S["JSON Schema"] --> FSM["Compile to a grammar<br/>or state machine"]
  P["Prompt"] --> LLM["LLM logits for the next token"]
  FSM --> MASK["Mask tokens the grammar<br/>doesn't allow here"]
  LLM --> MASK
  MASK --> SAMP["Sample from what is left"]
  SAMP --> ADV["Advance the state machine"]
  ADV --> LLM
  ADV --> OUT["Output always parses"]
