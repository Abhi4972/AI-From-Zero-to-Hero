flowchart TD
  CFG["GPTConfig"] --> EMB["Token + position embeddings"]
  EMB --> BLK["Block × L:<br/>LayerNorm → causal multi-head attention → +<br/>LayerNorm → MLP → +"]
  BLK --> LN["Final LayerNorm"]
  LN --> HEAD["LM head (tied weights)"]
  HEAD --> LOSS["Cross-entropy on the next token"]
  LOSS --> TR["Train loop: AdamW, warmup, cosine"]
  HEAD --> GEN["Generate: sample, append, repeat"]
