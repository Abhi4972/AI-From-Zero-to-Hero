flowchart TD
  IN["Input text"] --> ENC["Encoder<br/>runs once"]
  ENC --> MEM["Encoder states"]
  MEM --> DEC["Decoder<br/>runs once per output token,<br/>cross-attends to the states"]
  DEC --> OUT["Output text"]
  T5["T5 pretraining: corrupt spans,<br/>predict them"] -.-> ENC
  BART["BART pretraining: noise the text,<br/>reconstruct it"] -.-> DEC
