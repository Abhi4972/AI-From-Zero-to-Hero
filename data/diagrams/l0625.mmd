%% after: Idea 1
flowchart TD
  M1["New message for thread T"] --> LK{{"Lock for T free?<br/>(Postgres advisory lock)"}}
  LK -->|"yes"| RUN["Run the graph,<br/>then release the lock"]
  LK -->|"no: a run is going"| MS{{"Multitask strategy"}}
  MS -->|"reject"| R409["Refuse<br/>the new one"]
  MS -->|"enqueue"| Q["Run it after<br/>the current one"]
  MS -->|"interrupt"| I["Stop the current,<br/>keep its progress"]
  MS -->|"rollback"| RB["Delete the current<br/>as if it never ran"]
