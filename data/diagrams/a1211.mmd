flowchart TD
  IMG["Image"] --> VQ["VQ-VAE tokenizer<br/>1,024 codes from an 8,192-entry codebook"]
  TXT["Text"] --> BPE["BPE tokenizer"]
  VQ --> SEQ["One sequence, one shared vocabulary<br/>with image start/end markers"]
  BPE --> SEQ
  SEQ --> T["Single decoder transformer<br/>QK-Norm for stability"]
  T --> OUT["Next token: text or image code"]
  OUT -->|"image codes"| DEC["VQ decoder → pixels"]
