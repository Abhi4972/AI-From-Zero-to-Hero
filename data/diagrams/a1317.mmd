flowchart TD
  CL["Client"] -->|"POST /mcp"| GW["Gateway"]
  GW --> AU["Authenticate the principal"]
  AU --> VAL["Validate version and _meta"]
  VAL --> POL{{"Runtime policy:<br/>may this principal call this tool?"}}
  POL -->|"no"| DENY["Deny"]
  POL -->|"yes"| MAP["Public name → backend tool<br/>(deterministic namespacing)"]
  MAP --> BE["Admitted backend<br/>descriptor hash pinned"]
  BE --> GW
  REG["Registry admission<br/>decides which versions may join"] -.-> BE
