flowchart TD
  OBJ["Object file"] --> OB["Observe it yourself<br/>parse the bytes"]
  OB --> REC["Evidence record<br/>claim, source, authority"]
  DER["Derived table<br/>marked as derived"] --> REC
  PRED["Prediction<br/>an inferred record"] --> REC
  REC --> ID["evidence_id = hash of content<br/>(path not included)"]
  PRED --> RUN["Check against a real run"]
  RUN --> CONF["Confidence: confirmed,<br/>inferred or unknown"]
