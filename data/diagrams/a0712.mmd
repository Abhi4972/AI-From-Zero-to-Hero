flowchart TD
  P["Prompt"] --> PF["Prefill: all prompt tokens<br/>in parallel, compute-bound"]
  PF --> KV[("KV cache<br/>keys and values of past tokens")]
  KV --> DE["Decode: one token per step,<br/>memory-bound"]
  DE --> KV
  FA["Flash attention: tiles in fast SRAM,<br/>never writes the N × N matrix"] -.-> PF
  PA["PagedAttention: cache in blocks"] -.-> KV
  CB["Continuous batching: new requests<br/>join between steps"] -.-> DE
