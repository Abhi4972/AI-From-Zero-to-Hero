flowchart TD
  T{{"Transport"}} --> SI["stdio<br/>client launches the server"]
  T --> HT["Streamable HTTP<br/>one /mcp endpoint, POST only"]
  SI --> SL["one JSON message per line<br/>stdout for protocol, stderr for logs"]
  HT --> HD["Checks: Origin header,<br/>MCP-Protocol-Version header"]
  HD --> RP{{"Response"}}
  RP --> J["Plain JSON"]
  RP --> SS["SSE stream for this<br/>one request only"]
  HT --> SUB["Change notifications:<br/>client opens subscriptions/listen"]
